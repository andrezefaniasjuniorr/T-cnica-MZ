rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication and RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        getUserData().role == 'super_admin'
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'super_admin' ||
        getUserData().adminSubRole == 'super_admin'
      );
    }

    function isFinanceAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().adminSubRole == 'finance_admin'
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().adminSubRole == 'moderator'
      );
    }

    function isTechnician() {
      return isAuthenticated() && getUserData().role == 'technician';
    }

    function isCompany() {
      return isAuthenticated() && getUserData().role == 'company';
    }

    function isClient() {
      return isAuthenticated() && getUserData().role == 'client';
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      // User can create and edit their own non-role fields; only admin can edit roles
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'adminSubRole', 'status'])) || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // 2. Technicians Public Profiles
    match /technicians/{techId} {
      allow read: if true; // Public listing
      allow create: if isOwner(techId) && isTechnician();
      // Technician cannot self-approve subscription or verification status
      allow update: if (isOwner(techId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'subscriptionStatus', 'rating', 'completedJobsCount', 'featured']))) || isAdmin();
      allow delete: if isOwner(techId) || isSuperAdmin();
    }

    // 3. Technician Private Data (Sensitve docs, ID cards, private notes)
    match /technicianPrivateData/{techId} {
      allow read, write: if isOwner(techId) || isAdmin();
    }

    // 4. Companies Public Profiles
    match /companies/{companyId} {
      allow read: if true; // Public directory
      allow create: if isOwner(companyId) && isCompany();
      allow update: if (isOwner(companyId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'featured', 'rating', 'status']))) || isAdmin();
      allow delete: if isOwner(companyId) || isSuperAdmin();
    }

    // 5. Company Private Data (NUIT private records, commercial registry)
    match /companyPrivateData/{companyId} {
      allow read, write: if isOwner(companyId) || isAdmin();
    }

    // 6. Client Private Data
    match /clientPrivateData/{clientId} {
      allow read, write: if isOwner(clientId) || isAdmin();
    }

    // 7. Job Openings (/jobs)
    match /jobs/{jobId} {
      allow read: if true; // Public jobs feed
      allow create: if isCompany() || isAdmin();
      allow update, delete: if (isAuthenticated() && resource.data.companyId == request.auth.uid) || isAdmin();
    }

    // 8. Job Applications (/applications)
    match /jobApplications/{appId} {
      // ONLY the applying technician, the hiring company, and admins can read/write!
      allow read: if isAuthenticated() && (
        resource.data.technicianId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isTechnician() && request.resource.data.technicianId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.companyId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // 9. Service Requests & Proposals
    match /serviceRequests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if (isAuthenticated() && resource.data.clientId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.clientId == request.auth.uid) || isSuperAdmin();
    }

    match /proposals/{proposalId} {
      allow read: if isAuthenticated() && (
        resource.data.technicianId == request.auth.uid ||
        resource.data.clientId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isTechnician() && request.resource.data.technicianId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // 10. Payments & Receipts
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isFinanceAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isFinanceAdmin();
      allow delete: if isSuperAdmin();
    }

    // 11. Plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 12. Market Listings
    match /marketListings/{itemId} {
      allow read: if true;
      allow create: if isTechnician() || isCompany() || isAdmin();
      allow update, delete: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isModerator();
    }

    // 13. Academy Articles
    match /academyResources/{articleId} {
      allow read: if true;
      allow write: if isModerator() || isSuperAdmin();
    }

    // 14. Messaging & Conversations
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated() && (
        resource.data.participantIds.hasAny([request.auth.uid]) ||
        request.resource.data.participantIds.hasAny([request.auth.uid]) ||
        isSuperAdmin()
      );
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        request.resource.data.senderId == request.auth.uid ||
        isSuperAdmin()
      );
    }

    // 15. Notifications
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 16. Reports & Admin Logs
    match /reports/{reportId} {
      allow read: if isModerator() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isModerator();
      allow delete: if isSuperAdmin();
    }

    match /adminLogs/{logId} {
      allow read: if isSuperAdmin() || isFinanceAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Immutable audit log
    }

    // 17. Platform Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
