rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Authentication and RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'admin' ||
        getUserData().role == 'super_admin'
      );
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserData().role == 'super_admin' ||
        getUserData().adminSubRole == 'super_admin'
      );
    }

    function isFinanceAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().adminSubRole == 'finance_admin'
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getUserData().adminSubRole == 'moderator'
      );
    }

    // 1. Users & Usuarios collections - Real-time sync for authenticated users & Admins + Community engagement updates
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isOwner(userId) || isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'pontos', 'scoreEngajamento', 'likesCount', 'totalLikes', 'stars', 'badges', 'updatedAt'])) || true;
      allow delete: if isSuperAdmin() || isAdmin();
    }

    match /usuarios/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isOwner(userId) || isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'pontos', 'scoreEngajamento', 'likesCount', 'totalLikes', 'stars', 'badges', 'updatedAt'])) || true;
      allow delete: if isSuperAdmin() || isAdmin();
    }

    // 2. Technicians Public Profiles
    match /technicians/{techId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isOwner(techId) || isAdmin());
      allow update: if isOwner(techId) || isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'pontos', 'scoreEngajamento', 'likesCount', 'totalLikes', 'stars', 'badges', 'updatedAt'])) || true;
      allow delete: if isOwner(techId) || isSuperAdmin();
    }

    // 3. Companies Public Profiles
    match /companies/{companyId} {
      allow read: if true;
      allow create: if isAuthenticated() && (isOwner(companyId) || isAdmin());
      allow update: if isOwner(companyId) || isAdmin();
      allow delete: if isOwner(companyId) || isSuperAdmin();
    }

    // 4. Job Openings (/jobs)
    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && resource.data.companyId == request.auth.uid) || isAdmin();
    }

    // 5. Job Applications (/jobApplications)
    match /jobApplications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.technicianId == request.auth.uid ||
        resource.data.companyId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.companyId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    // 6. Service Requests & Proposals
    match /serviceRequests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if (isAuthenticated() && resource.data.clientId == request.auth.uid) || isAdmin();
      allow delete: if (isAuthenticated() && resource.data.clientId == request.auth.uid) || isSuperAdmin();
    }

    match /pedidos_servicos/{requestId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    match /proposals/{proposalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.technicianId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSuperAdmin();
    }

    match /propostas/{proposalId} {
      allow read, write: if isAuthenticated();
    }

    // 7. Payments & Receipts (pagamentos)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isFinanceAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isFinanceAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    match /pagamentos/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isFinanceAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isFinanceAdmin() || (isAuthenticated() && request.resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // 8. Plans
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 9. Market Items / Marketplace
    match /market_items/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isModerator() || isAdmin();

      match /comentarios/{commentId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isModerator() || isAdmin();
      }
    }
    match /marketListings/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if (isAuthenticated() && resource.data.sellerId == request.auth.uid) || isModerator() || isAdmin();
    }

    // 10. Community Posts / Mural & Comments
    match /mural_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isModerator() || isAdmin();

      match /comentarios/{commentId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isModerator() || isAdmin();
      }
    }

    match /community_posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isModerator() || isAdmin();

      match /comentarios/{commentId} {
        allow read: if true;
        allow create, update: if isAuthenticated();
        allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isModerator() || isAdmin();
      }
    }
    match /communityPosts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isModerator() || isAdmin();
    }

    // 10.1 Stories / Status (24 Horas)
    match /stories/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated(); // Allows updating views and emoji reactions
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isModerator() || isAdmin();
    }
    match /historias/{storyId} {
      allow read: if true;
      allow create: if isAuthenticated() && (request.resource.data.authorId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated();
      allow delete: if (isAuthenticated() && resource.data.authorId == request.auth.uid) || isModerator() || isAdmin();
    }

    // 11. Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || isModerator();
    }

    // 12. Portfolio
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 13. Academy Articles
    match /academyResources/{articleId} {
      allow read: if true;
      allow write: if isModerator() || isSuperAdmin();
    }

    // 14. Messaging & Conversations
    match /conversations/{conversationId} {
      allow read, write: if isAuthenticated();
    }
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();
    }

    match /messages/{messageId} {
      allow read, write: if isAuthenticated();
    }
    match /mensagens_diretas/{messageId} {
      allow read, write: if isAuthenticated();
    }

    // 15. Notifications (/notifications & /notificacoes)
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId in ['all', 'technician', 'company', 'client', 'tecnico', 'empresa', 'cliente'] ||
        isAdmin()
      );
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /notificacoes/{notifId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.userId in ['all', 'technician', 'company', 'client', 'tecnico', 'empresa', 'cliente'] ||
        isAdmin()
      );
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 16. Reports & Admin Logs
    match /reports/{reportId} {
      allow read: if isModerator() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isModerator();
      allow delete: if isSuperAdmin();
    }

    match /adminLogs/{logId} {
      allow read: if isSuperAdmin() || isFinanceAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // 17. Platform Settings
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
